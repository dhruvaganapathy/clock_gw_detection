Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Omega]", " ", ">", "0"}], ",", 
     RowBox[{"T", ">", "0"}], ",", 
     RowBox[{"\[CapitalOmega]", ">", "0"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9761620213799343`*^9, 3.976162035426772*^9}, 
   3.976162582623931*^9, 3.9761626330525723`*^9, 3.97616267009387*^9},
 CellLabel->
  "In[102]:=",ExpressionUUID->"85a28163-b41a-41c6-b10d-d178c65197c7"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9761625808932543`*^9, 
  3.976162580895114*^9}},ExpressionUUID->"3a31423a-7d2c-4767-8b6e-\
d00637edf69a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Tval", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalOmega]val", "=", 
    RowBox[{"20", " ", "Pi"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yRamseyFinite", "[", 
    RowBox[{"t_", ",", "T_", ",", "\[CapitalOmega]_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"\[CapitalOmega]", " ", "t"}], "]"}], ",", 
         RowBox[{"0", "<", "t", "<", 
          RowBox[{"\[Pi]", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "\[CapitalOmega]"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{
          RowBox[{"\[Pi]", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "\[CapitalOmega]"}], ")"}]}], "<", "t", "<", 
          RowBox[{
           RowBox[{"\[Pi]", "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "\[CapitalOmega]"}], ")"}]}], "+", "T"}]}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Pi]", "/", 
              RowBox[{"(", " ", "\[CapitalOmega]", ")"}]}], "+", "T", "-", 
             "t"}], ")"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Pi]", "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "\[CapitalOmega]"}], ")"}]}], "+", "T"}], "<", 
          "t", "<", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "\[CapitalOmega]"}], "+", "T"}]}]}], "}"}]}],
       "}"}], ",", "0"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"yRamseyFinite", "[", 
    RowBox[{"t_", ",", "T_", ",", "\[CapitalOmega]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Tau]", "=", 
       RowBox[{"Pi", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "\[CapitalOmega]"}], ")"}]}]}], "}"}], ",", 
     RowBox[{"Piecewise", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"\[CapitalOmega]", " ", "t"}], "]"}], ",", 
           RowBox[{"0", "<", "t", "<", "\[Tau]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"\[Tau]", "<=", "t", "<=", 
            RowBox[{"\[Tau]", "+", "T"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[CapitalOmega]", " ", 
             RowBox[{"(", 
              RowBox[{"t", "-", "\[Tau]", "-", "T"}], ")"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{"\[Tau]", "+", "T"}], "<", "t", "<", 
            RowBox[{
             RowBox[{"2", " ", "\[Tau]"}], "+", "T"}]}]}], "}"}]}], "}"}], 
       ",", "0"}], "]"}]}], "]"}]}], "\[IndentingNewLine]"}], "\n"}], "Input",\

 CellChangeTimes->{{3.976162191900736*^9, 3.976162192205223*^9}, {
   3.976162247894665*^9, 3.976162248212098*^9}, 3.976162456961195*^9, {
