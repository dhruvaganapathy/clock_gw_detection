Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"yRamseyFinite", "[", 
     RowBox[{"t_", ",", "T_", ",", "\[CapitalOmega]_"}], "]"}], ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[CapitalOmega]", " ", "t"}], "]"}], ",", 
          RowBox[{"0", "<", "t", "<", 
           RowBox[{"\[Pi]", "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "\[CapitalOmega]"}], ")"}]}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"\[Pi]", "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "\[CapitalOmega]"}], ")"}]}], "<", "t", "<", 
           RowBox[{
            RowBox[{"\[Pi]", "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "\[CapitalOmega]"}], ")"}]}], "+", "T"}]}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[CapitalOmega]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Pi]", "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "\[CapitalOmega]"}], ")"}]}], "+", "T", "-",
               "t"}], ")"}]}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Pi]", "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "\[CapitalOmega]"}], ")"}]}], "+", "T"}], "<",
            "t", "<", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "\[CapitalOmega]"}], "+", "T"}]}]}], 
         "}"}]}], "}"}], ",", "0"}], "]"}]}], "\[IndentingNewLine]", 
   "\n"}]}]], "Input",
